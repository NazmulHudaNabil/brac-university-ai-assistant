# ==============================================================================
# BRAC University AI Assistant - Environment Variables Template
# Copy this file to .env and fill in your own API keys.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Groq LLM API Keys (Inference Engine)
# ------------------------------------------------------------------------------
GROQ_API_KEY=""
GROQ_FALLBACK_API_KEY=""

# ------------------------------------------------------------------------------
# 2. Portkey LLM Gateway
# ------------------------------------------------------------------------------
PORTKEY_API_KEY=""
GROQ_SLUG="rag"                            # Virtual slug on Portkey for primary model
GROQ_SLUG_2="brag"                         # Virtual slug on Portkey for fallback model
PRIMARY_MODEL="openai/gpt-oss-120b"        # Primary LLM model name
FALLBACK_MODEL="openai/gpt-oss-120b"       # Fallback LLM model name

# ------------------------------------------------------------------------------
# 3. DeepEval Evaluation LLMs (Judge Keys)
# ------------------------------------------------------------------------------
JUDGE_GROQ=""
JUDGE_GROQ_FALLBACK=""

# ------------------------------------------------------------------------------
# 4. Qdrant Vector Database (Cloud)
# ------------------------------------------------------------------------------
QDRANT_API_KEY=""
QDRANT_CLUSTER_ENDPOINT=""                 # e.g., https://your-cluster.cloud.qdrant.io:6333
COLLECTION_NAME="bracu_docs"

# ------------------------------------------------------------------------------
# 5. Reranker & Embeddings
# ------------------------------------------------------------------------------
JINA_API_KEY=""                            # Jina AI Reranker API key
JINA_EMBEDDING_API_KEY=""                  # Optional Jina Embeddings API key
GEMINI_API_KEY=""                          # Google Gemini API key for embeddings
GOOGLE_API_KEY=""                          # Alternative Google API key
EMBEDDING_MODEL="gemini-embedding-2-preview"

# Optional Alternative Providers
MISTRAL_API_KEY=""

# ------------------------------------------------------------------------------
# 6. Observability & Tracing
# ------------------------------------------------------------------------------
# Pydantic Logfire
LOGFIRE_TOKEN=""

# LangSmith Tracing
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT="https://api.smith.langchain.com"
LANGSMITH_API_KEY=""
LANGSMITH_PROJECT="brac_university_ai_assistant"
